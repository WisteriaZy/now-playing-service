+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { cleanup, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import GeneralSettingsPage from "../src/pages/SettingsGeneral";
+import TosuSettings from "../src/components/TosuSettings";
+
+vi.mock("@/contexts/EnvContext", () => ({ useEnv: () => ({ isDesktop: false }) }));
+vi.mock("@/hooks/useOpenExternalUrl", () => ({ useOpenExternalUrl: () => ({ openExternalUrl: vi.fn() }) }));
+vi.mock("@/components/PlatformHelpDrawer", () => ({ default: () => null }));
+vi.mock("@heroui/toast", () => ({ addToast: vi.fn() }));
+
+// jsdom has no layout/animation engine; test visibility transitions without exit animations.
+vi.mock("framer-motion", async (original) => ({
+  ...await original<typeof import("framer-motion")>(),
+  AnimatePresence: ({ children }: { children: import("react").ReactNode }) => children,
+}));
+
+let selected = "tosu";
+let writes: Record<string, unknown>[] = [];
+beforeEach(() => {
+  selected = "tosu";
+  writes = [];
+  vi.stubGlobal("fetch", vi.fn(async (url: string, init?: RequestInit) => {
+    if (init?.method === "PUT") writes.push(JSON.parse(init.body as string));
+    const data = url === "/api/audio/devices" ? [{ id: "default", name: "Default" }]
+      : url === "/api/settings/general" ? { platform: selected, deviceId: "default", autoLaunchHomePage: false,
+        runAtStartup: false, updateCheckFreq: 7, smtc: true, fallbackPlatformEnabled: false,
+        fallbackPlatform: "netease", pollInterval: 100, weSingCachePath: "", tosuPort: 24050 }
+      : { data: false };
+    return { ok: true, json: async () => data };
+  }));
+});
+afterEach(() => { cleanup(); vi.unstubAllGlobals(); });
+
+describe("SPlayer platform selection", () => {
+  it("keeps Other and its saved configuration in More, with an accurate selected tab", async () => {
+    render(<GeneralSettingsPage />);
+    await screen.findByText("当前：osu!（tosu）");
+    expect(screen.queryByRole("tab", { name: /osu!（tosu）/ })).toBeNull();
+    expect(screen.queryByRole("spinbutton", { name: "tosu API 端口" })).toBeNull();
+    fireEvent.click(screen.getByRole("button", { name: /更多/ }));
+    const tab = await screen.findByRole("tab", { name: /osu!（tosu）/ });
+    expect(tab.getAttribute("aria-selected")).toBe("true");
+    await screen.findByRole("spinbutton", { name: "tosu API 端口" }, { timeout: 3000 });
+    expect(writes).toHaveLength(0); // loading saved settings must not save/reset them
+    fireEvent.click(screen.getByRole("tab", { name: /MusicFree/ }));
+    await waitFor(() => expect(screen.queryByRole("spinbutton", { name: "tosu API 端口" })).toBeNull());
+    fireEvent.click(tab);
+    await screen.findByRole("spinbutton", { name: "tosu API 端口" });
+    expect(tab.getAttribute("aria-selected")).toBe("true");
+    fireEvent.click(screen.getByRole("button", { name: "收起" }));
+    await waitFor(() => expect(screen.queryByRole("tab", { name: /osu!（tosu）/ })).toBeNull());
+    expect(screen.queryByRole("spinbutton", { name: "tosu API 端口" })).toBeNull();
+  });
+
+  it("does not show SPlayer settings for another saved platform, even after expanding", async () => {
+    selected = "netease";
+    render(<GeneralSettingsPage />);
+    fireEvent.click(screen.getByRole("button", { name: "更多" }));
+    const tab = await screen.findByRole("tab", { name: /osu!（tosu）/ });
+    expect(tab.getAttribute("aria-selected")).toBe("false");
+    expect(screen.queryByRole("spinbutton", { name: "tosu API 端口" })).toBeNull();
+  });
+});
+
+describe("compact port configuration", () => {
+  it("validates ports and only saves explicitly; keeps the draft on failure", async () => {
+    const save = vi.fn(async () => false);
+    render(<TosuSettings port={24050} onSave={save} />);
+    const input = screen.getByRole("spinbutton");
+    const button = screen.getByRole("button", { name: "保存端口并重新连接" });
+    expect(button.hasAttribute("disabled")).toBe(true);
+    for (const invalid of ["", "0", "65536", "1.5"]) {
+      fireEvent.change(input, { target: { value: invalid } });
+      expect(button.hasAttribute("disabled")).toBe(true);
+    }
+    fireEvent.change(input, { target: { value: "15555" } });
+    expect(save).not.toHaveBeenCalled();
+    fireEvent.click(button);
+    await waitFor(() => expect(save).toHaveBeenCalledWith(15555));
+    await waitFor(() => expect(button.hasAttribute("disabled")).toBe(false));
+    expect((input as HTMLInputElement).value).toBe("15555");
+  });
+
+  it("shows setup instructions in the help tooltip, not as permanent paragraphs", async () => {
+    render(<TosuSettings port={24050} onSave={vi.fn()} />);
+    expect(screen.queryByText(/先启动 tosu 和 osu!/)).toBeNull();
+    const user = userEvent.setup();
+    await user.tab();
+    await screen.findByText(/先启动 tosu 和 osu!/);
+  });
+});
