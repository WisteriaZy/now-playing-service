diff --git a/src/components/SPlayerNextSettings.tsx b/src/components/SPlayerNextSettings.tsx
new file mode 100644
index 0000000..637b887
--- /dev/null
+++ b/src/components/SPlayerNextSettings.tsx
@@ -0,0 +1,95 @@
+import { useEffect, useId, useState } from "react";
+import { Button } from "@heroui/button";
+import { Input } from "@heroui/input";
+import { Tooltip } from "@heroui/tooltip";
+import { QuestionCircle } from "@mynaui/icons-react";
+import { Save } from "lucide-react";
+
+interface Props {
+  port: number;
+  onSave: (port: number) => Promise<boolean>;
+}
+
+export default function SPlayerNextSettings({ port, onSave }: Props) {
+  const id = useId();
+  const [draft, setDraft] = useState(String(port));
+  const [saving, setSaving] = useState(false);
+  const valid = /^\d+$/.test(draft) && Number(draft) >= 1 && Number(draft) <= 65535;
+
+  useEffect(() => setDraft(String(port)), [port]);
+
+  const save = async () => {
+    if (!valid || saving || Number(draft) === port) return;
+    setSaving(true);
+    try {
+      await onSave(Number(draft));
+    } finally {
+      setSaving(false);
+    }
+  };
+
+  return (
+    <div className="flex flex-col gap-3 mt-4">
+      <div className="flex items-center text-primary-900 text-xs font-bold leading-none">
+        <label htmlFor={id}>SPlayer-Next API 端口</label>
+        <Tooltip
+          className="px-3 py-2 max-w-xs"
+          closeDelay={200}
+          delay={200}
+          placement="right"
+          content={
+            <div className="flex flex-col gap-1 text-xs leading-5 font-normal">
+              <span className="font-bold">连接 SPlayer-Next</span>
+              <span>在「设置 → 外部 API」中开启服务，端口与此处保持一致，默认 14558。</span>
+              <span>仅连接本机 127.0.0.1，无需开启 WebSocket 或局域网访问。</span>
+              <span>通过 HTTP 同步播放信息，不使用 SMTC 或音频设备检测；歌词仍由 Now Playing 独立获取。</span>
+              <span>未检测到歌曲时，请先播放音乐，并检查 API 开关和端口。</span>
+            </div>
+          }
+        >
+          <button type="button" aria-label="SPlayer-Next 连接帮助" className="ml-1 flex items-center cursor-pointer shrink-0 rounded focus-visible:outline-primary">
+            <QuestionCircle size={14} />
+          </button>
+        </Tooltip>
+      </div>
+      <div className="flex gap-2">
+        <Input
+          id={id}
+          aria-label="SPlayer-Next API 端口"
+          className="max-w-full w-full font-poppins"
+          classNames={{ inputWrapper: "px-4" }}
+          size="lg"
+          type="number"
+          min={1}
+          max={65535}
+          step={1}
+          value={draft}
+          onValueChange={setDraft}
+          isDisabled={saving}
+          isInvalid={!valid}
+          errorMessage="请输入 1–65535 之间的整数端口"
+          onKeyDown={(event) => {
+            if (event.key === "Enter") {
+              event.preventDefault();
+              void save();
+            }
+          }}
+        />
+        <Tooltip className="px-3" closeDelay={200} content="保存端口并重新连接" delay={200} placement="top">
+          <Button
+            aria-label="保存端口并重新连接"
+            isIconOnly
+            size="lg"
+            variant="flat"
+            className="bg-default-100 hover:bg-[#212123]"
+            isLoading={saving}
+            isDisabled={!valid || Number(draft) === port || saving}
+            onPress={save}
+          >
+            <Save size={20} strokeWidth={1.5} />
+          </Button>
+        </Tooltip>
+      </div>
+    </div>
+  );
+}
